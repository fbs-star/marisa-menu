PORT=3000
NODE_ENV=production

# Change this to a long random string before going live.
JWT_SECRET=change-this-to-a-long-random-string

# Used only the very first time the app starts, to create the initial
# admin login. Change the password from inside the admin panel afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe123!

# Turso (libSQL) database — persists across Render restarts/redeploys,
# unlike a local SQLite file on Render's free tier.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Cloudinary — stores uploaded photos off Render's ephemeral local disk.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

